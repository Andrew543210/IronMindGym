@model ProfileViewModel
@{
    ViewData["Title"] = "Profile";
}

<div class="section-heading"><div><p class="eyebrow">YOUR TRAINING IDENTITY</p><h2 class="mb-0">My profile</h2></div><a asp-action="Edit" class="btn btn-primary">Edit profile</a></div>
<div class="d-flex flex-wrap gap-2 mb-4"><a class="btn btn-outline-secondary btn-sm" asp-action="ChangePassword">Change password</a><a class="btn btn-outline-secondary btn-sm" asp-action="Export">Export my data ↓</a></div>
<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card"><div class="card-body">
            <p><strong>Username:</strong> @Model.Username</p>
            <p><strong>Email:</strong> @Model.Email</p>
            <p><strong>Age:</strong> @Model.Age</p>
            <p><strong>Avatar:</strong> @Model.AvatarName</p>
            <hr />
            <p><strong>Weight:</strong> @(Model.WeightKg.HasValue ? $"{Model.WeightKg:F1} kg" : "-")</p>
            <p><strong>Height:</strong> @(Model.HeightCm.HasValue ? $"{Model.HeightCm:F1} cm" : "-")</p>
            <p><strong>Anthropometry date:</strong> @(Model.AnthropometryRecordedAt.HasValue ? Model.AnthropometryRecordedAt.Value.ToLocalTime().ToString("yyyy-MM-dd") : "-")</p>
            <hr />
            <p><strong>Initial Bench Press:</strong> @(Model.BenchPressKg.HasValue ? $"{Model.BenchPressKg:F1} kg" : "-")</p>
            <p><strong>Initial Squat:</strong> @(Model.SquatKg.HasValue ? $"{Model.SquatKg:F1} kg" : "-")</p>
            <p><strong>Initial Deadlift:</strong> @(Model.DeadliftKg.HasValue ? $"{Model.DeadliftKg:F1} kg" : "-")</p>
            <hr />
            <a href="/ProgressTracker" class="btn btn-primary btn-sm mt-2">VIEW PROGRESS TRACKER</a>
        </div></div>
    </div>
    <div class="col-md-6">
        <div class="card"><div class="card-body">
            <h5>MY AWARDS</h5>
            @if (Model.Achievements.Any())
            {
                <ul>
                    @foreach (var achievement in Model.Achievements)
                    {
                        <li>
                            <strong>@achievement.Name</strong><br />
                            <span class="small text-muted">@achievement.ConditionDescription</span><br />
                            <span class="small text-muted">@achievement.AchievedAt.ToLocalTime().ToString("yyyy-MM-dd")</span>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="text-muted">No achievements yet</p>
            }
        </div></div>
    </div>
</div>

<div class="row g-4"><div class="col-lg-5"><div class="card h-100"><div class="card-body"><p class="eyebrow">CONSISTENCY OVER TIME</p><h4>Log your weight</h4><p class="text-muted small">One entry per date. Saving again updates that day's value.</p>
<form asp-action="LogWeight" method="post" class="row g-3"><div class="col-6"><label for="weightKg" class="form-label">Weight (kg)</label><input id="weightKg" name="WeightKg" type="number" step="0.1" min="30" max="250" required class="form-control" /></div><div class="col-6"><label for="weightDate" class="form-label">Date</label><input id="weightDate" name="Date" type="date" required value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" max="@DateTime.UtcNow.ToString("yyyy-MM-dd")" class="form-control" /></div><div class="col-12"><button class="btn btn-primary" type="submit">Save weight</button></div></form></div></div></div>
<div class="col-lg-7"><div class="card"><div class="card-body"><h4>Weight history</h4>
@if (!Model.WeightHistory.Any()) { <p class="text-muted">Your first entry starts the story.</p> }
else {
    var ordered = Model.WeightHistory.OrderBy(w => w.Date).ToList();
    var minimum = ordered.Min(w => w.ValueKg) - 2;
    var range = Math.Max(4, ordered.Max(w => w.ValueKg) - minimum);
    <div class="weight-bars" role="img" aria-label="Weight over your last 30 entries">
    @foreach (var log in ordered) { <div class="weight-bar" style="height:@((15 + (log.ValueKg - minimum) / range * 85).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture))%" title="@log.Date.ToString("MMM d"): @log.ValueKg kg"></div> }
    </div><div class="d-flex justify-content-between small text-muted mt-2"><span>@ordered.First().Date.ToString("MMM d")</span><span>@ordered.Last().Date.ToString("MMM d")</span></div>
    <details class="mt-3"><summary>View entries</summary><table class="table table-sm"><thead><tr><th>Date</th><th>Weight</th></tr></thead><tbody>@foreach (var log in Model.WeightHistory) { <tr><td>@log.Date.ToString("yyyy-MM-dd")</td><td>@log.ValueKg.ToString("0.0") kg</td></tr> }</tbody></table></details>
}
</div></div></div></div>
