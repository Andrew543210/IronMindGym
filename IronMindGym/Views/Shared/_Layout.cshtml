@{
    var signedIn = User.Identity?.IsAuthenticated == true;
    var current = ViewContext.RouteData.Values["controller"]?.ToString();
    var navigation = new[] { ("Dashboard", "Overview", "01"), ("WorkoutLogger", "Workout", "02"), ("ExerciseLibrary", "Exercises", "03"), ("ProgressTracker", "Progress", "04"), ("Nutrition", "Nutrition", "05"), ("Statistics", "Statistics", "06"), ("Goals", "Goals", "07"), ("Awards", "Awards", "08"), ("Friends", "Friends", "09") };
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0b0d0f" />
    <meta name="description" content="Your training journal. Log workouts, track your progress and build consistency." />
    <title>@ViewData["Title"] · IronMind</title>
    <link rel="icon" href="~/images/logo.jpg" />
    <link rel="stylesheet" href="~/lib/bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/monochrome.css" asp-append-version="true" />
</head>
<body class="mono-theme @(signedIn ? "app-shell" : "public-shell")">
<a href="#main" class="skip-link">Skip to content</a>
@if (signedIn)
{
    <aside class="sidebar" aria-label="Main navigation">
        <a class="brand" asp-controller="Dashboard" asp-action="Index"><img src="~/images/logo.jpg" alt="" /><span>IRONMIND<small>BUILD YOUR OWN STANDARD</small></span></a>
        <p class="nav-caption">YOUR TRAINING SPACE</p>
        <nav>
            @foreach (var item in navigation)
            {
                <a class="sidebar-link @(current == item.Item1 ? "active" : "")" asp-controller="@item.Item1" asp-action="Index" aria-current="@(current == item.Item1 ? "page" : null)"><span class="nav-number">@item.Item3</span>@item.Item2</a>
            }
        </nav>
        <div class="sidebar-bottom"><p>Small steps.<br /><strong>Stronger every week.</strong></p><a class="sidebar-link @(current == "Profile" ? "active" : "")" asp-controller="Profile" asp-action="Index"><span class="nav-number">↗</span>My profile</a></div>
    </aside>
}
<div class="page-shell">
    <header class="topbar">
        @if (signedIn) { <div><span class="status-dot"></span><span class="topbar-label">YOUR PERSONAL TRAINING JOURNAL</span></div> }
        else { <a class="brand" asp-controller="Auth" asp-action="Login">IRONMIND</a> }
        <div class="d-flex align-items-center gap-3">
            @if (signedIn)
            {
                <a class="profile-link" asp-controller="Profile" asp-action="Index">My account ↗</a>
                <form method="post" asp-controller="Auth" asp-action="Logout"><button type="submit" class="btn btn-sm btn-outline-secondary">Sign out</button></form>
            }
            else { <span class="text-muted small">TRAIN. TRACK. PROGRESS.</span> }
        </div>
    </header>
    <main id="main" class="main-content">
        @if (TempData["Message"] is string message) { <div class="alert alert-success" role="status">@message</div> }
        @if (TempData["Error"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
        @RenderBody()
    </main>
    <footer class="page-footer"><span>IRONMIND</span><span>Progress is personal. Keep yours moving.</span></footer>
</div>
@if (signedIn)
{
    <nav class="mobile-nav" aria-label="Quick navigation">
        <a class="@(current == "Dashboard" ? "active" : "")" asp-controller="Dashboard" asp-action="Index"><b>⌂</b>Home</a>
        <a class="@(current == "WorkoutLogger" ? "active" : "")" asp-controller="WorkoutLogger" asp-action="Index"><b>＋</b>Workout</a>
        <a class="@(current == "ProgressTracker" ? "active" : "")" asp-controller="ProgressTracker" asp-action="Index"><b>↗</b>Progress</a>
        <a class="@(current == "Nutrition" ? "active" : "")" asp-controller="Nutrition" asp-action="Index"><b>◉</b>Nutrition</a>
        <button id="moreNavigation" type="button" aria-expanded="false" aria-controls="moreMenu"><b>•••</b>More</button>
    </nav>
    <div id="moreMenu" class="more-menu" hidden>
        @foreach (var item in navigation.Where(n => n.Item1 is not ("Dashboard" or "WorkoutLogger" or "ProgressTracker" or "Nutrition")))
        { <a asp-controller="@item.Item1" asp-action="Index">@item.Item2 ↗</a> }
        <a asp-controller="Profile" asp-action="Index">My profile ↗</a>
    </div>
}
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
