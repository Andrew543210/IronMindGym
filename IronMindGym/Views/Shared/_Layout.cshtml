@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - IronMind</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/monochrome.css" asp-append-version="true" />
</head>
<body class="mono-theme">
@{
    var isLoggedIn = Context.Session.GetInt32("UserId").HasValue || (Context.User.Identity?.IsAuthenticated ?? false);
}
<nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
    <div class="container">
        <a class="navbar-brand" asp-controller="Dashboard" asp-action="Index">IronMind</a>
        <div class="navbar-nav me-auto">
            @if (isLoggedIn)
            {
                <a class="nav-link" asp-controller="Setup" asp-action="Index">Setup</a>
                <a class="nav-link" asp-controller="ExerciseLibrary" asp-action="Index">Exercises</a>
                <a class="nav-link" asp-controller="WorkoutLogger" asp-action="Index">Workout</a>
                <a class="nav-link" asp-controller="Nutrition" asp-action="Index">Nutrition</a>
                <a class="nav-link" asp-controller="Statistics" asp-action="Index">Stats</a>
                <a class="nav-link" asp-controller="Statistics" asp-action="Records">Records</a>
                <a class="nav-link" asp-controller="Friends" asp-action="Index">Friends</a>
                <a class="nav-link" asp-controller="Profile" asp-action="Index">Profile</a>
            }
        </div>

        <div class="navbar-nav">
            @if (isLoggedIn)
            {
                <form method="post" asp-controller="Auth" asp-action="Logout" class="d-inline">
                    <button type="submit" class="btn btn-outline-light btn-sm">Logout</button>
                </form>
            }
            else
            {
                <a class="nav-link" asp-controller="Auth" asp-action="Login">Login</a>
                <a class="nav-link" asp-controller="Auth" asp-action="Register">Register</a>
            }
        </div>
    </div>
</nav>

<div class="container">
    @if (TempData["Message"] is string message)
    {
        <div class="alert alert-success">@message</div>
    }
    @RenderBody()
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

