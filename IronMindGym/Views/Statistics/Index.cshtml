@model StatisticsViewModel
@{
    ViewData["Title"] = "Статистика";
}

<h2>Статистика</h2>
<div class="row g-3 mb-4">
    <div class="col-md-3"><div class="card"><div class="card-body">Занять: <strong>@Model.WorkoutsCompleted</strong></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body">Тоннаж (30 днів): <strong>@Model.MonthlyTotalTonnage</strong></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body">Сер. калораж: <strong>@Model.AvgWeeklyCalories</strong></div></div></div>
    <div class="col-md-3"><div class="card"><div class="card-body">Білок-норма: <strong>@Model.ProteinGoalAdherencePercent%</strong></div></div></div>
</div>

<h4>Особисті рекорди</h4>
<table class="table">
    <thead><tr><th>Вправа</th><th>Max вага</th></tr></thead>
    <tbody>
    @foreach (var pr in Model.PersonalRecords)
    {
        <tr><td>@pr.ExerciseName</td><td>@pr.MaxWeight кг</td></tr>
    }
    </tbody>
</table>

