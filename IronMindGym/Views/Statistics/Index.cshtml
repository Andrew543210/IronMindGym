@model StatisticsViewModel
@{
    ViewData["Title"] = "Statistics";
}

<h2>STATISTICS</h2>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border border-light h-100">
            <div class="card-body">
                <h6 class="text-muted small mb-2">TOTAL WORKOUTS</h6>
                <h3 class="mb-0">@Model.WorkoutsCompleted</h3>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border border-light h-100">
            <div class="card-body">
                <h6 class="text-muted small mb-2">TOTAL TIME</h6>
                <h3 class="mb-0">@Model.TotalWorkoutMinutes <span class="small">min</span></h3>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border border-light h-100">
            <div class="card-body">
                <h6 class="text-muted small mb-2">AVG DURATION</h6>
                <h3 class="mb-0">@Model.AvgWorkoutDurationMinutes <span class="small">min</span></h3>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border border-light h-100">
            <div class="card-body">
                <h6 class="text-muted small mb-2">LONGEST STREAK</h6>
                <h3 class="mb-0">@Model.LongestStreak <span class="small">days</span></h3>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border border-light h-100">
            <div class="card-body">
                <h6 class="text-muted small mb-2">TOTAL TONNAGE (30d)</h6>
                <h3 class="mb-0">@Model.MonthlyTotalTonnage <span class="small">tons</span></h3>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border border-light h-100">
            <div class="card-body">
                <h6 class="text-muted small mb-2">AVG REST</h6>
                <h3 class="mb-0">@Model.AvgRestSeconds <span class="small">sec</span></h3>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card border border-light h-100">
            <div class="card-body">
                <h6 class="text-muted small mb-2">BEST PROGRESS</h6>
                <h3 class="mb-1">@Model.BestProgressPercent<span class="small">%</span></h3>
                <p class="small text-muted mb-0">@Model.BestProgressExercise</p>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border border-light h-100">
            <div class="card-body">
                <h6 class="text-muted small mb-2">TOTAL AWARDS</h6>
                <h3 class="mb-0">@Model.TotalAwardsCount</h3>
            </div>
        </div>
    </div>
</div>

<h4 class="mt-5 mb-3">VOLUME & FREQUENCY</h4>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border border-light h-100">
            <div class="card-body">
                <h6 class="text-muted small mb-2">TOTAL VOLUME</h6>
                <h3 class="mb-0">@Model.TotalVolume <span class="small">kg×reps</span></h3>
                <p class="small text-muted mb-0 mt-2">Cumulative lifting</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border border-light h-100">
            <div class="card-body">
                <h6 class="text-muted small mb-2">TOTAL SETS</h6>
                <h3 class="mb-0">@Model.TotalSetsCount</h3>
                <p class="small text-muted mb-0 mt-2">Sets performed</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border border-light h-100">
            <div class="card-body">
                <h6 class="text-muted small mb-2">AVG SETS/WORKOUT</h6>
                <h3 class="mb-0">@Model.AvgSetsPerWorkout</h3>
                <p class="small text-muted mb-0 mt-2">Per session</p>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border border-light h-100">
            <div class="card-body">
                <h6 class="text-muted small mb-2">UNIQUE EXERCISES</h6>
                <h3 class="mb-0">@Model.UniquExercisesCount</h3>
                <p class="small text-muted mb-0 mt-2">Different exercises</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border border-light h-100">
            <div class="card-body">
                <h6 class="text-muted small mb-2">EXERCISES (30d)</h6>
                <h3 class="mb-0">@Model.ExercisesThisMonth</h3>
                <p class="small text-muted mb-0 mt-2">This month</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border border-light h-100">
            <div class="card-body">
                <h6 class="text-muted small mb-2">WEEKLY FREQUENCY</h6>
                <h3 class="mb-0">@Model.AvgWeeklyWorkouts</h3>
                <p class="small text-muted mb-0 mt-2">Per week average</p>
            </div>
        </div>
    </div>
</div>

<h4 class="mt-5 mb-3">PROGRESS TRENDS</h4>

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card border border-light h-100">
            <div class="card-body">
                <h6 class="text-muted small mb-2">WEEKLY VOLUME</h6>
                <h3 class="mb-1">@Model.WeeklyProgress <span class="small">kg×reps</span></h3>
                <p class="small text-muted mb-0">Last 7 days: @Model.Last7DaysInfo</p>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border border-light h-100">
            <div class="card-body">
                <h6 class="text-muted small mb-2">MONTHLY VOLUME</h6>
                <h3 class="mb-0">@Model.MonthlyProgress <span class="small">kg×reps</span></h3>
                <p class="small text-muted mb-0 mt-2">Last 30 days</p>
            </div>
        </div>
    </div>
</div>

<h4 class="mt-5 mb-3">FAVORITE EXERCISE</h4>

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card border border-light h-100">
            <div class="card-body">
                <h6 class="text-muted small mb-2">MOST PERFORMED</h6>
                <h3 class="mb-1">@Model.FavoriteExerciseName</h3>
                <p class="small text-muted mb-0">@Model.FavoriteExerciseCount times</p>
            </div>
        </div>
    </div>
</div>

<h4 class="mt-4">PERSONAL RECORDS</h4>
<a class="btn btn-outline-primary btn-sm mb-3" asp-action="Records">View All Records</a>
<table class="table">
    <thead><tr><th>Exercise</th><th>Max weight</th></tr></thead>
    <tbody>
    @foreach (var pr in Model.PersonalRecords.Take(10))
    {
        <tr><td>@pr.ExerciseName</td><td>@pr.MaxWeight kg</td></tr>
    }
    </tbody>
</table>

