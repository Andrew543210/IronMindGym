@model ProgressTrackerViewModel
@{
    ViewData["Title"] = "Progress Tracker";
}

<div class="container mt-4">
    <h2 class="mb-4">PROGRESS TRACKER</h2>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="row mb-4">
        <div class="col-md-12">
            <a href="/ProgressTracker/TrackExercise" class="btn btn-primary">
                + ADD EXERCISE PROGRESS
            </a>
        </div>
    </div>

    @if (Model.Exercises.Any())
    {
        <div class="row">
            @foreach (var group in Model.Exercises.GroupBy(e => e.MuscleGroup))
            {
                <div class="col-md-12 mb-4">
                    <h4>@group.Key</h4>
                    <div class="row g-3">
                        @foreach (var exercise in group)
                        {
                            <div class="col-md-6 col-lg-4">
                                <div class="card h-100 border border-light" style="min-height: 350px; display: flex; flex-direction: column;">
                                    <div class="card-header bg-dark text-white">
                                        <strong>@exercise.ExerciseName</strong>
                                        <br />
                                        <small class="text-muted">@exercise.MuscleSubGroup</small>
                                    </div>
                                    <div class="card-body d-flex flex-column flex-grow-1">
                                        <div class="row g-2 mb-3 flex-grow-1">
                                            <!-- INITIAL -->
                                            <div class="col-4">
                                                <div class="border-end ps-0 pe-2">
                                                    <h6 class="text-muted small fw-bold">INITIAL</h6>
                                                    @if (exercise.ExerciseType == ExerciseType.Cardio)
                                                    {
                                                        <p class="small mb-1"><strong>@exercise.InitialDurationSeconds</strong>s</p>
                                                        <p class="small mb-0"><strong>@exercise.InitialIntensity</strong>/10</p>
                                                    }
                                                    else
                                                    {
                                                        <p class="small mb-1"><strong>@exercise.InitialWeightKg</strong> kg</p>
                                                        <p class="small mb-0"><strong>@exercise.InitialReps</strong> reps</p>
                                                    }
                                                </div>
                                            </div>

                                            <!-- PROGRESS -->
                                            <div class="col-4">
                                                <div class="text-center border-end ps-1 pe-1">
                                                    <h6 class="text-success small fw-bold">PROGRESS</h6>
                                                    @if (exercise.ExerciseType == ExerciseType.Cardio)
                                                    {
                                                        <p class="small mb-0"><strong class="text-success">+@exercise.CardioEffortProgressPercent.ToString("F1")%</strong></p>
                                                    }
                                                    else
                                                    {
                                                        <p class="small mb-1"><strong class="text-success">+@exercise.WeightProgressKg.ToString("F1")</strong> kg</p>
                                                        <p class="small mb-0 text-success">@exercise.WeightProgressPercent.ToString("F1")%</p>
                                                    }
                                                </div>
                                            </div>

                                            <!-- CURRENT -->
                                            <div class="col-4">
                                                <div class="ps-2 pe-0">
                                                    <h6 class="text-info small fw-bold">CURRENT</h6>
                                                    @if (exercise.ExerciseType == ExerciseType.Cardio)
                                                    {
                                                        <p class="small mb-1"><strong>@exercise.CurrentDurationSeconds</strong>s</p>
                                                        <p class="small mb-0"><strong>@exercise.CurrentIntensity</strong>/10</p>
                                                    }
                                                    else
                                                    {
                                                        <p class="small mb-1"><strong>@exercise.CurrentWeightKg</strong> kg</p>
                                                        <p class="small mb-0"><strong>@exercise.CurrentReps</strong> reps</p>
                                                    }
                                                </div>
                                            </div>
                                        </div>

                                        <div class="mt-2 mb-3 px-2 border-top pt-2">
                                            <h6 class="small fw-bold">UPDATE PROGRESS</h6>
                                            <div class="input-group input-group-sm">
                                                @if (exercise.ExerciseType == ExerciseType.Cardio)
                                                {
                                                    <input type="number" class="form-control" id="update_val1_@exercise.ExerciseId" placeholder="Secs" required>
                                                    <input type="number" class="form-control" id="update_val2_@exercise.ExerciseId" placeholder="Int(1-10)" min="1" max="10" required>
                                                }
                                                else
                                                {
                                                    <input type="number" step="0.5" class="form-control" id="update_val1_@exercise.ExerciseId" placeholder="New Weight" required>
                                                    <input type="number" class="form-control" id="update_val2_@exercise.ExerciseId" placeholder="New Reps" required>
                                                }
                                                <button type="button" class="btn btn-primary" onclick="setResultFromIndex(@exercise.ExerciseId, @((int)exercise.ExerciseType))">Set Result</button>
                                            </div>
                                        </div>

                                        <div class="row g-2 mt-auto">
                                            <div class="col-6">
                                                <a class="btn btn-sm btn-outline-primary w-100" href="@Url.Action("TrackExercise", "ProgressTracker")?exerciseId=@exercise.ExerciseProgressId">Edit</a>
                                            </div>
                                            <div class="col-6">
                                                <button type="button" class="btn btn-sm btn-outline-danger w-100" onclick="deleteProgressFromIndex(@exercise.Id, this)">Delete</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info">
            No progress tracked yet. Click "+ ADD EXERCISE PROGRESS" to start!
        </div>
    }
</div>





@Html.AntiForgeryToken()
<script>
    async function deleteProgressFromIndex(exerciseProgressId, btn) {
        if (!confirm('Delete this progress tracker?')) return;
        const formData = new FormData();
        formData.append('exerciseProgressId', exerciseProgressId);
        try {
            const res = await fetch('/ProgressTracker/DeleteProgress', { method: 'POST', headers: { 'X-CSRF-TOKEN': document.querySelector('input[name="__RequestVerificationToken"]').value }, body: formData });
            const json = await res.json();
            if (json.success) {
                // remove the card containing the button
                const card = btn.closest('.col-md-6, .col-lg-4');
                if (card) card.remove();
                // show a small toast
                alert('Progress tracker deleted');
            } else {
                alert('Error deleting: ' + (json.message || 'unknown'));
            }
        } catch (e) {
            alert('Error deleting: ' + e.message);
        }
    }

    async function setResultFromIndex(exerciseId, type) {
        const val1 = document.getElementById('update_val1_' + exerciseId).value;
        const val2 = document.getElementById('update_val2_' + exerciseId).value;
        if (!val1 || !val2) {
            alert('Please enter both values');
            return;
        }

        const formData = new FormData();
        formData.append('exerciseId', exerciseId);
        if (type === 1) { // Cardio (assuming 1 is cardio, need to check enum)
            formData.append('durationSeconds', val1);
            formData.append('intensity', val2);
        } else {
            formData.append('weightKg', val1);
            formData.append('reps', val2);
        }

        try {
            const res = await fetch('/ProgressTracker/SetCurrentResults', { method: 'POST', headers: { 'X-CSRF-TOKEN': document.querySelector('input[name="__RequestVerificationToken"]').value }, body: formData });
            const json = await res.json();
            if (json.success) {
                location.reload();
            } else {
                alert('Error: ' + json.message);
            }
        } catch (e) {
            alert('Error: ' + e.message);
        }
    }
</script>
