@model FriendWorkoutDetailsViewModel
@using IronMindGym.Controllers
@{
    ViewData["Title"] = "Friend Workout Details";
}

<h2>@Model.FriendUsername - Workout Details</h2>
<div class="card mb-3">
    <div class="card-body">
        <h5>@ExerciseLibraryController.TranslateSessionNameForDisplay(Model.Details.Session.Name)</h5>
        <div>Date: @Model.Details.Session.SessionDate.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</div>
        <div>Duration: @Model.Details.Session.DurationMinutes min</div>
        <div>Rating: @(Model.Details.Session.Review?.Rating ?? 0)/5</div>
        <div>Comment: @(string.IsNullOrWhiteSpace(Model.Details.Session.Review?.Comment) ? "-" : Model.Details.Session.Review!.Comment)</div>
    </div>
</div>

@foreach (var performed in Model.Details.Session.PerformedExercises.OrderBy(x => x.OrderInWorkout))
{
    var hasSetType = performed.Sets.Any(s =>
        s.SetType != null &&
        !string.IsNullOrWhiteSpace(s.SetType.Name) &&
        !s.SetType.Name.Equals("Failure", StringComparison.OrdinalIgnoreCase));

    <div class="card mb-3">
        <div class="card-body">
            <h6>@ExerciseLibraryController.TranslateExerciseNameForDisplay(performed.Exercise.Name)</h6>
            <table class="table table-sm">
                <thead>
                <tr>
                    <th>Set</th>
                    @if (hasSetType)
                    {
                        <th>Type</th>
                    }
                    <th>Weight</th>
                    <th>Reps</th>
                    <th>Rest</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var set in performed.Sets.OrderBy(s => s.SetNumber))
                {
                    <tr>
                        <td>@set.SetNumber</td>
                        @if (hasSetType)
                        {
                            <td>@(set.SetType?.Name ?? string.Empty)</td>
                        }
                        <td>@set.WeightKg kg</td>
                        <td>@set.Reps</td>
                        <td>@set.RestSeconds sec</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}

<div class="card border-success">
    <div class="card-body">
        <h5>Session Statistics</h5>
        <p class="mb-3">Average rest: <strong>@Model.Details.Summary.AverageRestSeconds sec</strong></p>
        <table class="table table-sm">
            <thead><tr><th>Exercise</th><th>Sets</th><th>Average load (% of PR)</th><th>Peak load (% of PR)</th><th>Record</th></tr></thead>
            <tbody>
            @foreach (var stat in Model.Details.Summary.ExerciseStats)
            {
                <tr>
                    <td>@stat.ExerciseName</td>
                    <td>@stat.SetsCount</td>
                    <td>@(stat.AverageLoad.HasValue ? $"{stat.AverageLoad}%" : "-")</td>
                    <td>@(stat.PeakLoad.HasValue ? $"{stat.PeakLoad}%" : "-")</td>
                    <td>@(stat.IsNewRecord ? "New record" : "No new record")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-outline-light">Back to friends</a>
</div>

