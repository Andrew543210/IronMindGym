@model FriendsViewModel
@{
    ViewData["Title"] = "Друзі";
}

<h2>Друзі</h2>
<form method="get" class="row g-2 mb-3">
    <div class="col-md-4">
        <input name="searchUsername" value="@Model.SearchUsername" class="form-control" placeholder="Пошук за username" />
    </div>
    <div class="col-md-2">
        <button class="btn btn-outline-primary" type="submit">Пошук</button>
    </div>
</form>

@foreach (var friend in Model.Friends)
{
    <div class="card mb-2">
        <div class="card-body">
            <div>
                <strong>@friend.Username</strong>
                <div class="small text-muted">Статус: @friend.Status</div>
                <div class="small text-muted">Середній калораж: @Math.Round(friend.AverageKcal, 1) ккал</div>
            </div>
            <div class="mt-2">Останні тренування: @friend.LastFiveWorkoutsCount</div>
            <ul class="mb-0 mt-1">
                @foreach (var workout in friend.LastFiveWorkouts)
                {
                    <li>@workout.SessionDate.ToLocalTime().ToString("MM-dd HH:mm") - @workout.Name (@workout.DurationMinutes хв)</li>
                }
            </ul>
        </div>
    </div>
}

