@model FriendsViewModel
@{
    ViewData["Title"] = "Friends";
}

<h2>Train together</h2>
<p class="text-muted">Connect with a training partner. Only accepted friends can see each other’s workouts, nutrition and progress.</p>
<form method="get" class="row g-2 mb-3">
    <div class="col-md-4">
        <input name="searchUsername" value="@Model.SearchUsername" class="form-control" placeholder="Search by username" />
    </div>
    <div class="col-md-2">
        <button class="btn btn-outline-primary" type="submit">Search</button>
    </div>
</form>

@if (!Model.Friends.Any())
{
    <div class="alert alert-secondary">No connections yet. Search for a username to invite a training partner.</div>
}

@foreach (var friend in Model.Friends)
{
    <div class="card mb-3">
        <div class="card-body">
            <div>
                <strong>@friend.Username</strong>
                <div class="small text-muted">Status: @friend.Status</div>
                @if (friend.IsFriend) {<div class="small text-muted">Average calories: <span class="metric">@Math.Round(friend.AverageKcal, 1)</span> kcal</div>}
            </div>

            <div class="d-flex gap-2 mt-3">
                @if (friend.RequestReceived)
                {
                    <form method="post" asp-action="Accept"><input type="hidden" name="userId" value="@friend.UserId" /><button class="btn btn-primary btn-sm">Accept request</button></form>
                }
                @if (!friend.IsFriend && !friend.RequestSent && !friend.RequestReceived)
                {
                    <form method="post" asp-action="SendRequest"><input type="hidden" name="userId" value="@friend.UserId" /><button class="btn btn-primary btn-sm">Add friend</button></form>
                }
                else
                {
                    <form method="post" asp-action="Remove"><input type="hidden" name="userId" value="@friend.UserId" /><button class="btn btn-outline-secondary btn-sm">@(friend.IsFriend ? "Remove friend" : friend.RequestSent ? "Cancel request" : "Decline")</button></form>
                }
            </div>
            @if (friend.IsFriend)
            {
            <hr />
            <h6>Last 5 workouts</h6>
            @if (!friend.LastFiveWorkouts.Any())
            {
                <div class="small text-muted">No workouts yet.</div>
            }
            else
            {
                <ul class="mb-0 mt-1">
                    @foreach (var workout in friend.LastFiveWorkouts)
                    {
                        <li>
                            <span class="metric">@workout.SessionDate.ToLocalTime().ToString("MM-dd HH:mm")</span> - @workout.Name (<span class="metric">@workout.DurationMinutes</span> min)
                            <a class="btn btn-outline-light btn-sm ms-2" asp-action="WorkoutDetails" asp-route-friendId="@friend.UserId" asp-route-workoutSessionId="@workout.WorkoutSessionId">Details</a>
                        </li>
                    }
                </ul>
            }

            <hr />
            <h6>Nutrition (last 10 days)</h6>
            @if (!friend.LastNutritionLogs.Any())
            {
                <div class="small text-muted">No nutrition logs yet.</div>
            }
            else
            {
                <table class="table table-sm">
                    <thead>
                    <tr>
                        <th>Date</th><th>Kcal</th><th>P</th><th>F</th><th>C</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var log in friend.LastNutritionLogs)
                    {
                        <tr>
                            <td class="metric">@log.Date.ToLocalTime().ToString("yyyy-MM-dd")</td>
                            <td class="metric">@log.CaloriesKcal</td>
                            <td class="metric">@log.ProteinG</td>
                            <td class="metric">@log.FatG</td>
                            <td class="metric">@log.CarbsG</td>
                        </tr>
                    }
                    </tbody>
                </table>
            }

            <hr />
            <h6>Personal records</h6>
            @if (!friend.PersonalRecords.Any())
            {
                <div class="small text-muted">No personal records yet.</div>
            }
            else
            {
                <ul class="mb-0 mt-1">
                    @foreach (var record in friend.PersonalRecords)
                    {
                        <li>@record.ExerciseName: <span class="metric">@record.MaxWeightKg</span> kg (<span class="metric">@record.UpdatedAt.ToLocalTime().ToString("yyyy-MM-dd")</span>)</li>
                    }
                </ul>
            }

            <hr />
            <h6>Awards</h6>
            @if (!friend.Achievements.Any())
            {
                <div class="small text-muted">No awards yet.</div>
            }
            else
            {
                <ul class="mb-0 mt-1">
                    @foreach (var award in friend.Achievements)
                    {
                        <li>
                            <strong>@award.Name</strong>
                            <span class="small text-muted">- @award.ConditionDescription (@award.AchievedAt.ToLocalTime().ToString("yyyy-MM-dd"))</span>
                        </li>
                    }
                </ul>
            }

            <hr />
            <div class="row g-2">
                <div class="col-md-12">
                    <a asp-controller="ProgressTracker" asp-action="ViewFriendProgress" asp-route-friendId="@friend.UserId" class="btn btn-outline-light btn-sm w-100">
                        VIEW PROGRESS TRACKER
                    </a>
                </div>
            </div>
            }
        </div>
    </div>
}

