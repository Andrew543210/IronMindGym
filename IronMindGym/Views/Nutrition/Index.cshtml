@model NutritionViewModel
@{
    ViewData["Title"] = "Харчування";
}

<h2>Журнал КБЖУ</h2>
<form method="post" class="row g-3">
    <div class="col-md-3">
        <label asp-for="CaloriesKcal" class="form-label">Калорії</label>
        <input asp-for="CaloriesKcal" class="form-control" />
    </div>
    <div class="col-md-3">
        <label asp-for="ProteinG" class="form-label">Білки (г)</label>
        <input asp-for="ProteinG" class="form-control" />
    </div>
    <div class="col-md-3">
        <label asp-for="FatG" class="form-label">Жири (г)</label>
        <input asp-for="FatG" class="form-control" />
    </div>
    <div class="col-md-3">
        <label asp-for="CarbsG" class="form-label">Вуглеводи (г)</label>
        <input asp-for="CarbsG" class="form-control" />
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-primary">Зберегти</button>
    </div>
</form>

@if (!string.IsNullOrWhiteSpace(Model.SystemAdvice))
{
    <div class="alert alert-info mt-4">
        <strong>Оцінка системи:</strong> @Model.SystemAdvice
    </div>
}

