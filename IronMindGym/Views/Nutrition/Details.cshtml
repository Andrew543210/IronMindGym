@model NutritionDetailsViewModel
@{
    ViewData["Title"] = "Деталі харчування";
}

<h2>Деталі харчування</h2>

<div class="card mb-4">
    <div class="card-body">
        <h5>Запис за @Model.Log.Date.ToLocalTime().ToString("yyyy-MM-dd")</h5>
        <div class="row g-3 mt-1">
            <div class="col-md-3"><strong>Калорії:</strong> <span class="metric">@Model.Log.CaloriesKcal</span></div>
            <div class="col-md-3"><strong>Білки:</strong> <span class="metric">@Model.Log.ProteinG</span> г</div>
            <div class="col-md-3"><strong>Жири:</strong> <span class="metric">@Model.Log.FatG</span> г</div>
            <div class="col-md-3"><strong>Вуглеводи:</strong> <span class="metric">@Model.Log.CarbsG</span> г</div>
        </div>
    </div>
</div>

<div class="alert alert-info mb-4">
    <div><strong>Оцінка системи:</strong> @Model.SystemAdvice</div>
    <div class="mt-1"><strong>Вердикт:</strong> @Model.SystemVerdict</div>
    <div><strong>Score:</strong> <span class="metric">@Model.SystemScore</span>/100</div>

    @if (Model.AdviceItems.Any())
    {
        <hr />
        <ul class="mb-0">
            @foreach (var tip in Model.AdviceItems)
            {
                <li>@tip</li>
            }
        </ul>
    }
</div>

<div class="card">
    <div class="card-body">
        <h5>Останні 10 днів</h5>
        @if (!Model.RecentLogs.Any())
        {
            <p class="mb-0">Ще немає записів.</p>
        }
        else
        {
            <table class="table table-sm mt-3 mb-0">
                <thead>
                <tr>
                    <th>Дата</th>
                    <th>Калорії</th>
                    <th>Б</th>
                    <th>Ж</th>
                    <th>В</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                @foreach (var day in Model.RecentLogs)
                {
                    <tr>
                        <td class="metric">@day.Date.ToLocalTime().ToString("yyyy-MM-dd")</td>
                        <td class="metric">@day.CaloriesKcal</td>
                        <td class="metric">@day.ProteinG</td>
                        <td class="metric">@day.FatG</td>
                        <td class="metric">@day.CarbsG</td>
                        <td>
                            @if (day.Id == Model.Log.Id)
                            {
                                <span class="badge text-bg-light">Поточний</span>
                            }
                            else
                            {
                                <a asp-action="Details" asp-route-id="@day.Id" class="btn btn-outline-light btn-sm">Деталі</a>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-light text-dark">Назад до журналу</a>
</div>

