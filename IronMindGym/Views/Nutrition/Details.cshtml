@model NutritionDetailsViewModel
@{
    ViewData["Title"] = "Nutrition Details";
}

<h2>Nutrition Details</h2>

<div class="card mb-4">
    <div class="card-body">
        <h5>Entry for @Model.Log.Date.ToLocalTime().ToString("yyyy-MM-dd")</h5>
        <div class="row g-3 mt-1">
            <div class="col-md-3"><strong>Calories:</strong> <span class="metric">@Model.Log.CaloriesKcal</span></div>
            <div class="col-md-3"><strong>Protein:</strong> <span class="metric">@Model.Log.ProteinG</span> g</div>
            <div class="col-md-3"><strong>Fat:</strong> <span class="metric">@Model.Log.FatG</span> g</div>
            <div class="col-md-3"><strong>Carbs:</strong> <span class="metric">@Model.Log.CarbsG</span> g</div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <h5>Your targets</h5>
        <div class="row g-2">
            <div class="col-md-4">BMR estimate: <span class="metric">@(Model.BasalMetabolicRate > 0 ? $"{Model.BasalMetabolicRate:0} kcal" : "Off")</span></div>
            <div class="col-md-4">Activity factor: <span class="metric">@(Model.ActivityMultiplier > 0 ? Model.ActivityMultiplier.ToString("F2") : "Off")</span></div>
            <div class="col-md-4">Calories target: <span class="metric">@NutritionTargetsViewModel.DisplayTarget(Model.TargetCaloriesKcal, "kcal")</span></div>
            <div class="col-md-4">Protein target: <span class="metric">@NutritionTargetsViewModel.DisplayTarget(Model.TargetProteinG, "g")</span></div>
            <div class="col-md-4">Fat target: <span class="metric">@NutritionTargetsViewModel.DisplayTarget(Model.TargetFatG, "g")</span></div>
            <div class="col-md-4">Carbs target: <span class="metric">@NutritionTargetsViewModel.DisplayTarget(Model.TargetCarbsG, "g")</span></div>
        </div>
    </div>
</div>

<div class="alert alert-info mb-4">
    <div><strong>Daily comparison:</strong> @Model.SystemAdvice</div>
    <div class="mt-1"><strong>Target match:</strong> @Model.SystemVerdict</div>
    <div><strong>Target match:</strong> <span class="metric">@Model.SystemScore</span>/100</div>

    @if (Model.AdviceItems.Any())
    {
        <hr />
        <ul class="mb-0">
            @foreach (var tip in Model.AdviceItems)
            {
                <li>@tip</li>
            }
        </ul>
    }
</div>

<div class="card">
    <div class="card-body">
        <h5>Last 10 days</h5>
        @if (!Model.RecentLogs.Any())
        {
            <p class="mb-0">No entries yet.</p>
        }
        else
        {
            <table class="table table-sm mt-3 mb-0">
                <thead>
                <tr>
                    <th>Date</th>
                    <th>Calories</th>
                    <th>P</th>
                    <th>F</th>
                    <th>C</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                @foreach (var day in Model.RecentLogs)
                {
                    <tr>
                        <td class="metric">@day.Date.ToLocalTime().ToString("yyyy-MM-dd")</td>
                        <td class="metric">@day.CaloriesKcal</td>
                        <td class="metric">@day.ProteinG</td>
                        <td class="metric">@day.FatG</td>
                        <td class="metric">@day.CarbsG</td>
                        <td>
                            @if (day.Id == Model.Log.Id)
                            {
                                <span class="badge text-bg-light">Current</span>
                            }
                            else
                            {
                                <a asp-action="Details" asp-route-id="@day.Id" class="btn btn-outline-light btn-sm">Details</a>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
</div>

<div class="mt-3">

        <a asp-action="Index" asp-route-date="@Model.Log.Date.ToString("yyyy-MM-dd")" class="btn btn-light text-dark">Edit entry</a>
    <a asp-action="Index" class="btn btn-light text-dark">Back to log</a>
</div>


<form asp-action="Delete" method="post" class="mt-3" onsubmit="return confirm('Delete this nutrition entry?')"><input type="hidden" name="id" value="@Model.Log.Id" /><button class="btn btn-outline-danger" type="submit">Delete entry</button></form>
