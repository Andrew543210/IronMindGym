@model NutritionDetailsViewModel
@{
    ViewData["Title"] = "Nutrition Details";
}

<h2>Nutrition Details</h2>

<div class="card mb-4">
    <div class="card-body">
        <h5>Entry for @Model.Log.Date.ToLocalTime().ToString("yyyy-MM-dd")</h5>
        <div class="row g-3 mt-1">
            <div class="col-md-3"><strong>Calories:</strong> <span class="metric">@Model.Log.CaloriesKcal</span></div>
            <div class="col-md-3"><strong>Protein:</strong> <span class="metric">@Model.Log.ProteinG</span> g</div>
            <div class="col-md-3"><strong>Fat:</strong> <span class="metric">@Model.Log.FatG</span> g</div>
            <div class="col-md-3"><strong>Carbs:</strong> <span class="metric">@Model.Log.CarbsG</span> g</div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <h5>Calculated Targets</h5>
        <div class="row g-2">
            <div class="col-md-4">BMR: <span class="metric">@Model.BasalMetabolicRate</span> kcal</div>
            <div class="col-md-4">PAL: <span class="metric">@Model.ActivityMultiplier.ToString("F2")</span></div>
            <div class="col-md-4">Calories target: <span class="metric">@Model.TargetCaloriesKcal</span> kcal</div>
            <div class="col-md-4">Protein target: <span class="metric">@Model.TargetProteinG</span> g</div>
            <div class="col-md-4">Fat target: <span class="metric">@Model.TargetFatG</span> g</div>
            <div class="col-md-4">Carbs target: <span class="metric">@Model.TargetCarbsG</span> g</div>
        </div>
    </div>
</div>

<div class="alert alert-info mb-4">
    <div><strong>System Evaluation:</strong> @Model.SystemAdvice</div>
    <div class="mt-1"><strong>Verdict:</strong> @Model.SystemVerdict</div>
    <div><strong>Score:</strong> <span class="metric">@Model.SystemScore</span>/100</div>

    @if (Model.AdviceItems.Any())
    {
        <hr />
        <ul class="mb-0">
            @foreach (var tip in Model.AdviceItems)
            {
                <li>@tip</li>
            }
        </ul>
    }
</div>

<div class="card">
    <div class="card-body">
        <h5>Last 10 days</h5>
        @if (!Model.RecentLogs.Any())
        {
            <p class="mb-0">No entries yet.</p>
        }
        else
        {
            <table class="table table-sm mt-3 mb-0">
                <thead>
                <tr>
                    <th>Date</th>
                    <th>Calories</th>
                    <th>P</th>
                    <th>F</th>
                    <th>C</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                @foreach (var day in Model.RecentLogs)
                {
                    <tr>
                        <td class="metric">@day.Date.ToLocalTime().ToString("yyyy-MM-dd")</td>
                        <td class="metric">@day.CaloriesKcal</td>
                        <td class="metric">@day.ProteinG</td>
                        <td class="metric">@day.FatG</td>
                        <td class="metric">@day.CarbsG</td>
                        <td>
                            @if (day.Id == Model.Log.Id)
                            {
                                <span class="badge text-bg-light">Current</span>
                            }
                            else
                            {
                                <a asp-action="Details" asp-route-id="@day.Id" class="btn btn-outline-light btn-sm">Details</a>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
</div>

<div class="mt-3">
    @if (Model.Log.IsToday)
    {
        <a asp-action="EditToday" asp-route-id="@Model.Log.Id" class="btn btn-light text-dark">Edit today's entry</a>
    }
    <a asp-action="Index" class="btn btn-light text-dark">Back to log</a>
</div>

