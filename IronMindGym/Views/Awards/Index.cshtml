@model AwardsViewModel
@{
    ViewData["Title"] = "Awards";
}

<h2>Awards</h2>
<p class="text-muted">Track all achievements and your current progress toward each goal.</p>

<div class="row g-3">
    @foreach (var award in Model.Awards)
    {
        var cardClass = award.IsUnlocked ? "border border-light" : "border border-white-25";
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 @cardClass">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h5 class="mb-0">@award.Name</h5>
                        @if (award.IsUnlocked)
                        {
                            <span class="badge bg-light text-dark">&#10003;</span>
                        }
                    </div>
                    <div class="small text-muted mb-3">@award.ConditionDescription</div>

                    <div class="progress mb-2" role="progressbar" aria-valuenow="@award.ProgressPercent" aria-valuemin="0" aria-valuemax="100">
                        <div class="progress-bar @(award.IsUnlocked ? "bg-light text-dark" : "bg-secondary")" style="width: @award.ProgressPercent.ToString("F0")%;"></div>
                    </div>

                    @if (award.IsNumeric)
                    {
                        <div class="small mt-auto">
                            Current: <span class="metric">@award.CurrentValue.ToString("F1")</span>
                            /
                            Target: <span class="metric">@award.TargetValue.ToString("F1")</span>
                            (<span class="metric">@award.ProgressPercent.ToString("F0")%</span>)
                        </div>
                    }
                    else
                    {
                        <div class="small mt-auto text-muted">Progress is available after related actions are completed.</div>
                    }
                </div>
            </div>
        </div>
    }
</div>

