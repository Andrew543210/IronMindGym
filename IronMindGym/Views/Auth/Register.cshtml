@model RegisterViewModel
@{
    ViewData["Title"] = "Register";
}

<div class="auth-layout"><div class="auth-story"><p class="eyebrow">BUILT ONE SESSION AT A TIME</p><h1>Show up.<br />Get stronger.<br />Repeat.</h1><p>One place for your training, nutrition and every small win along the way.</p></div><div class="auth-form"><p class="eyebrow">YOUR NEXT CHAPTER</p><h2>Make it yours</h2><p class="text-muted small mb-4">Create an account and build your training rhythm.</p>
<form method="post" class="row g-3">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="col-md-3">
        <label asp-for="Username" class="form-label"></label>
        <input asp-for="Username" class="form-control" />
        <span asp-validation-for="Username" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" autocomplete="email" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="Age" class="form-label">Age</label>
        <input asp-for="Age" class="form-control" type="number" min="12" max="100" />
        <span asp-validation-for="Age" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="Password" class="form-label"></label>
        <input asp-for="Password" class="form-control" autocomplete="new-password" type="password" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="ConfirmPassword" class="form-label">Confirm password</label>
        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" type="password" />
        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-success">Create account</button>
        <a asp-action="Login" class="btn btn-outline-secondary">Back to login</a>
    </div>
</form></div></div>
