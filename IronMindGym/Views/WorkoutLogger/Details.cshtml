@model WorkoutDetailsViewModel
@{
    ViewData["Title"] = "Workout Details";
}

<h2>Workout Details</h2>
<div class="card mb-3">
    <div class="card-body">
        <h5>@Model.Session.Name</h5>
        <div>Date: @Model.Session.SessionDate.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</div>
        <div>Duration: @Model.Session.DurationMinutes min</div>
        <div>Rating: @(Model.Session.Review?.Rating ?? 0)/5</div>
        <div>Comment: @(string.IsNullOrWhiteSpace(Model.Session.Review?.Comment) ? "-" : Model.Session.Review!.Comment)</div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
            <div>
                <strong>Session reactions</strong>
                <div class="small">Likes: <span class="metric">@Model.LikesCount</span></div>
            </div>
            <form method="post" asp-action="ToggleLike" class="mb-0">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Session.Id" />
                <button type="submit" class="btn @(Model.IsLikedByCurrentUser ? "btn-light text-dark" : "btn-outline-light") btn-sm">
                    @(Model.IsLikedByCurrentUser ? "Unlike" : "Like")
                </button>
            </form>
        </div>

        <form method="post" asp-action="AddComment" class="row g-2">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Session.Id" />
            <div class="col-md-10">
                <input type="text" name="commentText" maxlength="500" class="form-control" placeholder="Write a comment" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-outline-light w-100">Post</button>
            </div>
        </form>

        <hr />
        @if (!Model.Comments.Any())
        {
            <div class="small text-muted">No comments yet.</div>
        }
        else
        {
            @foreach (var comment in Model.Comments)
            {
                <div class="mb-2">
                    <div><strong>@comment.AuthorUsername</strong> <span class="small text-muted">@comment.Date.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span></div>
                    <div>@comment.Text</div>
                </div>
            }
        }
    </div>
</div>

@foreach (var performed in Model.Session.PerformedExercises.OrderBy(x => x.OrderInWorkout))
{
    var hasSetType = performed.Sets.Any(s => !string.IsNullOrWhiteSpace(s.SetType?.Name));
    <div class="card mb-3">
        <div class="card-body">
            <h6>@performed.Exercise.Name</h6>
            <table class="table table-sm">
                <thead>
                <tr>
                    <th>Set</th>
                    @if (hasSetType)
                    {
                        <th>Type</th>
                    }
                    <th>@(performed.Exercise.Type != ExerciseType.StrengthTraining ? "Duration" : "Weight")</th>
                    <th>@(performed.Exercise.Type != ExerciseType.StrengthTraining ? (performed.Exercise.Type == ExerciseType.Cardio ? "Intensity" : "Load") : "Reps")</th>
                    <th>Rest</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var set in performed.Sets.OrderBy(s => s.SetNumber))
                {
                    <tr>
                        <td>@set.SetNumber</td>
                        @if (hasSetType)
                        {
                            <td>@set.SetType.Name</td>
                        }
                        <td>@(performed.Exercise.Type != ExerciseType.StrengthTraining ? $"{set.DurationSeconds} sec" : $"{set.WeightKg} kg")</td>
                        <td>@(performed.Exercise.Type != ExerciseType.StrengthTraining ? (performed.Exercise.Type == ExerciseType.Cardio ? $"{set.Intensity}/10" : $"{set.WeightKg} kg") : set.Reps.ToString())</td>
                        <td>@set.RestSeconds sec</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}

<div class="card border-success">
    <div class="card-body">
        <h5>Session Statistics</h5>
        <p class="mb-1">Average rest: <strong>@Model.Summary.AverageRestSeconds sec</strong></p>
        <p class="mb-3">Workouts left this week: <strong>@Model.Summary.RemainingWorkoutsThisWeek</strong></p>
        <table class="table table-sm">
            <thead><tr><th>Exercise</th><th>Sets</th><th>Avg load (% of previous max)</th><th>Peak (% of previous max)</th><th>Record</th></tr></thead>
            <tbody>
            @foreach (var stat in Model.Summary.ExerciseStats)
            {
                <tr>
                    <td>@stat.ExerciseName</td>
                    <td>@stat.SetsCount</td>
                    <td>@(stat.AverageLoad.HasValue ? $"{stat.AverageLoad}%" : "-")</td>
                    <td>@(stat.PeakLoad.HasValue ? $"{stat.PeakLoad}%" : "-")</td>
                    <td>@(stat.IsNewRecord ? "New record" : "No update")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>


<form method="post" asp-action="Delete" class="mt-4" onsubmit="return confirm('Delete this workout? This cannot be undone.')">
<input type="hidden" name="id" value="@Model.Session.Id" />
<button class="btn btn-outline-danger" type="submit">Delete workout</button>
</form>

@if (TempData["ClearWorkoutDraft"] is true) { <script>try { sessionStorage.removeItem("ironmind-workout-@User.GetUserId()"); } catch {}</script> }
