@model WorkoutLoggerViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Workout Logger";
    var catalogJson = JsonSerializer.Serialize(Model.ExerciseCatalog);
}

<h2>Workout Logger</h2>

<div class="d-flex justify-content-between align-items-center mb-3">
    <p class="mb-0 text-muted">Latest workouts and quick launch of a new session.</p>
    @if (!Model.IsTrainingActive)
    {
        <a class="btn btn-primary" asp-action="Index" asp-route-startTraining="true">Start workout</a>
    }
</div>

@if (Model.LastSummary != null)
{
    <div class="card mb-4 border-success">
        <div class="card-body">
            <h5>@Model.LastSummary.SessionName</h5>
            <p class="mb-1">Average rest: <strong class="metric">@Model.LastSummary.AverageRestSeconds sec</strong></p>
            <p class="mb-3">Workouts remaining this week: <strong class="metric">@Model.LastSummary.RemainingWorkoutsThisWeek</strong></p>
            <table class="table table-sm">
                <thead><tr><th>Exercise</th><th>Avg load (% of PR)</th><th>Peak load (% of PR)</th><th>Status</th></tr></thead>
                <tbody>
                @foreach (var stat in Model.LastSummary.ExerciseStats)
                {
                    <tr>
                        <td>@stat.ExerciseName</td>
                        <td class="metric">@(stat.AverageLoad.HasValue ? $"{stat.AverageLoad}%" : "-")</td>
                        <td class="metric">@(stat.PeakLoad.HasValue ? $"{stat.PeakLoad}%" : "-")</td>
                        <td>@(stat.IsNewRecord ? "New record" : "No new record")</td>
                    </tr>
                }
                </tbody>
            </table>
            <a class="btn btn-outline-success btn-sm" asp-action="Details" asp-route-id="@Model.LastSummary.WorkoutSessionId">Details</a>
        </div>
    </div>
}

@if (!Model.IsTrainingActive)
{
<h4>Your workout history</h4>
<ul class="list-group mb-4">
    @foreach (var s in Model.RecentSessions)
    {
        <li class="list-group-item d-flex justify-content-between align-items-center">
            <span><span class="metric">@s.SessionDate.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span> - @s.Name (<span class="metric">@s.DurationMinutes</span> min)</span>
            <a class="btn btn-outline-primary btn-sm" asp-action="Details" asp-route-id="@s.Id">Details</a>
        </li>
    }
</ul>

<div class="d-flex gap-2 mb-4">
    @if ((ViewBag.Page ?? 1) > 1) { <a class="btn btn-outline-secondary btn-sm" asp-route-page="@((int)ViewBag.Page - 1)">← Newer</a> }
    @if (Model.RecentSessions.Count == 20) { <a class="btn btn-outline-secondary btn-sm" asp-route-page="@((int)(ViewBag.Page ?? 1) + 1)">Older →</a> }
</div>
}
@if (Model.IsTrainingActive)
{
<form method="post" asp-action="Finish" class="row g-3 mb-4" id="finishWorkoutForm" novalidate data-user-id="@User.GetUserId()">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="col-12">
        <div class="card border-secondary">
            <details>
            <summary class="card-header">Session settings · @Model.ActiveSplitTypeName</summary>
            <div class="card-body row g-3">
                <div class="col-md-4">
                    <label asp-for="SplitTypeId" class="form-label">Split type</label>
                    @if (Model.ActiveSplitTypeName.Length > 0)
                    {
                        <select asp-for="SplitTypeId" asp-items="ViewBag.SplitTypes" class="form-select" disabled></select>
                        <input asp-for="SplitTypeId" type="hidden" />
                    }
                    else
                    {
                        <select asp-for="SplitTypeId" asp-items="ViewBag.SplitTypes" class="form-select"></select>
                    }
                </div>
                <div class="col-md-4">
                    <label asp-for="SplitDayLabel" class="form-label">Split day</label>
                    <select asp-for="SplitDayLabel" asp-items="ViewBag.SplitDays" class="form-select"></select>
                </div>
                <div class="col-md-4">
                    <label asp-for="DurationMinutes" class="form-label">Duration (min)</label>
                    <input asp-for="DurationMinutes" class="form-control" />
                </div>
            </div>
            </details>
        </div>
    </div>

    <div class="col-12">
        <div class="card border-secondary">
            <div class="card-header">Add exercises and sets</div>
            <div class="card-body row g-3">
                <div class="col-md-4">
                    <label for="muscleGroupFilter" class="form-label">1) Muscle group</label>
                    <select asp-for="SelectedMuscleGroupId" asp-items="ViewBag.MuscleGroups" class="form-select" id="muscleGroupFilter">
                        <option value="">Select group</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label for="muscleSubGroupFilter" class="form-label">2) Muscle subgroup (optional)</label>
                    <select asp-for="SelectedMuscleSubGroupId" class="form-select" id="muscleSubGroupFilter" disabled>
                        <option value="">Select a group first</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label for="exerciseSelect" class="form-label">3) Exercise</label>
                    <select asp-for="ExerciseId" class="form-select" id="exerciseSelect" disabled>
                        <option value="">Select a group first</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <label for="setTypeSelect" class="form-label">Set type</label>
                    <select asp-for="SetTypeId" asp-items="ViewBag.SetTypes" class="form-select" id="setTypeSelect"></select>
                </div>

                <div class="col-md-3" id="weightContainer">
                    <label for="weightInput" class="form-label">Weight (kg)</label>
                    <input asp-for="WeightKg" class="form-control" id="weightInput" type="number" inputmode="decimal" min="0" max="500" step="0.5" />
                </div>
                <div class="col-md-3" id="repsContainer">
                    <label for="repsInput" class="form-label">Reps</label>
                    <input asp-for="Reps" class="form-control" id="repsInput" inputmode="numeric" />
                </div>

                <div class="col-md-3" id="durationContainer" style="display: none;">
                    <label for="durationInput" class="form-label">Duration (sec)</label>
                    <input type="number" class="form-control" id="durationInput" min="0" />
                </div>
                <div class="col-md-3" id="intensityContainer" style="display: none;">
                    <label for="intensityInput" class="form-label">Intensity (1-10)</label>
                    <input type="number" class="form-control" id="intensityInput" min="1" max="10" value="5" />
                </div>

                <div class="col-md-3">
                    <label for="restInput" class="form-label">Rest (sec)</label>
                    <input asp-for="RestSeconds" class="form-control" id="restInput" inputmode="numeric" />
                </div>

                <div class="col-12"><div id="workoutError" class="alert alert-danger" role="alert" hidden></div><div class="d-flex gap-2"><button type="button" class="btn btn-primary flex-grow-1" id="addSetBtn">Add set ＋</button><button type="button" class="btn btn-outline-secondary" id="repeatSetBtn" title="Repeat the selected exercise and values">Repeat ↻</button></div><p class="small text-muted mt-2 mb-0">Draft stays in this tab if you reload. Use 0 kg for bodyweight work.</p></div>

                <div class="col-12">
                    <div class="workout-toolbar d-flex flex-wrap gap-3 align-items-center justify-content-between" id="restTimerPanel">
                        <span>Rest timer: <strong class="metric" id="restTimerValue">02:00</strong></span>
                        <div>
                            <button type="button" class="btn btn-outline-secondary btn-sm" id="startTimerBtn">Start timer</button>
                            <button type="button" class="btn btn-outline-warning btn-sm" id="skipTimerBtn">Skip rest</button>
                        </div>
                    </div>
                    <div class="text-white fw-bold" id="timerReadyText"></div>
                </div>

                <div class="col-12">
                    <div class="section-heading"><h5 class="mb-0">This session</h5><span class="small text-muted" id="draftCount"></span></div><p class="text-muted small" id="emptyDraft">Your first set starts here.</p>
                    <table class="table table-sm" id="draftSetsTable">
                        <thead>
                        <tr>
                            <th>#</th>
                            <th>Exercise</th>
                            <th>Type</th>
                            <th>Load / duration</th>
                            <th>Reps / effort</th>
                            <th>Rest</th>
                            <th></th>
                        </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-2">
        <label asp-for="ReviewRating" class="form-label">Rating</label>
        <input asp-for="ReviewRating" class="form-control" min="1" max="5" />
    </div>
    <div class="col-md-10">
        <label asp-for="ReviewComment" class="form-label">Review</label>
        <input asp-for="ReviewComment" class="form-control" placeholder="How did the workout go?" />
    </div>

    <input asp-for="DraftPayloadJson" type="hidden" id="draftPayloadJson" />
    <input asp-for="StartedAtUtc" type="hidden" />

    <div class="col-12">
        <button type="submit" class="btn btn-success" id="finishWorkoutBtn">Finish workout</button>
    </div>
</form>
}

@if (Model.IsTrainingActive)
{
    <script id="exerciseCatalog" type="application/json">@Html.Raw(catalogJson)</script>
    <script src="~/js/workout.js" asp-append-version="true"></script>
}
