@model WorkoutLoggerViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Workout Logger";
    var catalogJson = JsonSerializer.Serialize(Model.ExerciseCatalog);
}

<h2>Workout Logger</h2>

<div class="d-flex justify-content-between align-items-center mb-3">
    <p class="mb-0 text-muted">Latest workouts and quick launch of a new session.</p>
    @if (!Model.IsTrainingActive)
    {
        <a class="btn btn-primary" asp-action="Index" asp-route-startTraining="true">Start workout</a>
    }
</div>

@if (Model.LastSummary != null)
{
    <div class="card mb-4 border-success">
        <div class="card-body">
            <h5>@Model.LastSummary.SessionName</h5>
            <p class="mb-1">Average rest: <strong class="metric">@Model.LastSummary.AverageRestSeconds sec</strong></p>
            <p class="mb-3">Workouts remaining this week: <strong class="metric">@Model.LastSummary.RemainingWorkoutsThisWeek</strong></p>
            <table class="table table-sm">
                <thead><tr><th>Exercise</th><th>Avg load (% of PR)</th><th>Peak load (% of PR)</th><th>Status</th></tr></thead>
                <tbody>
                @foreach (var stat in Model.LastSummary.ExerciseStats)
                {
                    <tr>
                        <td>@stat.ExerciseName</td>
                        <td class="metric">@(stat.AverageLoad.HasValue ? $"{stat.AverageLoad}%" : "-")</td>
                        <td class="metric">@(stat.PeakLoad.HasValue ? $"{stat.PeakLoad}%" : "-")</td>
                        <td>@(stat.IsNewRecord ? "New record" : "No new record")</td>
                    </tr>
                }
                </tbody>
            </table>
            <a class="btn btn-outline-success btn-sm" asp-action="Details" asp-route-id="@Model.LastSummary.WorkoutSessionId">Details</a>
        </div>
    </div>
}

<h4>Last 5 workouts</h4>
<ul class="list-group mb-4">
    @foreach (var s in Model.RecentSessions)
    {
        <li class="list-group-item d-flex justify-content-between align-items-center">
            <span><span class="metric">@s.SessionDate.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span> - @s.Name (<span class="metric">@s.DurationMinutes</span> min)</span>
            <a class="btn btn-outline-primary btn-sm" asp-action="Details" asp-route-id="@s.Id">Details</a>
        </li>
    }
</ul>

@if (Model.IsTrainingActive)
{
<form method="post" asp-action="Finish" class="row g-3 mb-4" id="finishWorkoutForm">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="col-12">
        <div class="card border-secondary">
            <div class="card-header">Active Workout</div>
            <div class="card-body row g-3">
                <div class="col-md-4">
                    <label asp-for="SplitTypeId" class="form-label">Split type</label>
                    @if (Model.ActiveSplitTypeName.Length > 0)
                    {
                        <select asp-for="SplitTypeId" asp-items="ViewBag.SplitTypes" class="form-select" disabled></select>
                        <input asp-for="SplitTypeId" type="hidden" />
                    }
                    else
                    {
                        <select asp-for="SplitTypeId" asp-items="ViewBag.SplitTypes" class="form-select"></select>
                    }
                </div>
                <div class="col-md-4">
                    <label asp-for="SplitDayLabel" class="form-label">Split day</label>
                    <select asp-for="SplitDayLabel" asp-items="ViewBag.SplitDays" class="form-select"></select>
                </div>
                <div class="col-md-4">
                    <label asp-for="DurationMinutes" class="form-label">Duration (min)</label>
                    <input asp-for="DurationMinutes" class="form-control" />
                </div>
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="card border-secondary">
            <div class="card-header">Add exercises and sets</div>
            <div class="card-body row g-3">
                <div class="col-md-4">
                    <label asp-for="SelectedMuscleGroupId" class="form-label">1) Muscle group</label>
                    <select asp-for="SelectedMuscleGroupId" asp-items="ViewBag.MuscleGroups" class="form-select" id="muscleGroupFilter">
                        <option value="">Select group</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label asp-for="SelectedMuscleSubGroupId" class="form-label">2) Muscle subgroup (optional)</label>
                    <select asp-for="SelectedMuscleSubGroupId" class="form-select" id="muscleSubGroupFilter" disabled>
                        <option value="">Select a group first</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label asp-for="ExerciseId" class="form-label">3) Exercise</label>
                    <select asp-for="ExerciseId" class="form-select" id="exerciseSelect" disabled>
                        <option value="">Select a group first</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <label asp-for="SetTypeId" class="form-label">Set type</label>
                    <select asp-for="SetTypeId" asp-items="ViewBag.SetTypes" class="form-select" id="setTypeSelect"></select>
                </div>
                <div class="col-md-3">
                    <label asp-for="WeightKg" class="form-label">Weight (kg)</label>
                    <input asp-for="WeightKg" class="form-control" id="weightInput" />
                </div>
                <div class="col-md-3">
                    <label asp-for="Reps" class="form-label">Reps</label>
                    <input asp-for="Reps" class="form-control" id="repsInput" />
                </div>
                <div class="col-md-3">
                    <label asp-for="RestSeconds" class="form-label">Rest (sec)</label>
                    <input asp-for="RestSeconds" class="form-control" id="restInput" />
                </div>

                <div class="col-12">
                    <button type="button" class="btn btn-primary" id="addSetBtn">Add set</button>
                </div>

                <div class="col-12">
                    <div class="alert alert-secondary d-flex align-items-center justify-content-between" id="restTimerPanel">
                        <span>Rest timer: <strong class="metric" id="restTimerValue">02:00</strong></span>
                        <div>
                            <button type="button" class="btn btn-outline-secondary btn-sm" id="startTimerBtn">Start timer</button>
                            <button type="button" class="btn btn-outline-warning btn-sm" id="skipTimerBtn">Skip rest</button>
                        </div>
                    </div>
                    <div class="text-white fw-bold" id="timerReadyText"></div>
                </div>

                <div class="col-12">
                    <h5>Added sets in current session</h5>
                    <table class="table table-sm" id="draftSetsTable">
                        <thead>
                        <tr>
                            <th>#</th>
                            <th>Exercise</th>
                            <th>Type</th>
                            <th>Weight</th>
                            <th>Reps</th>
                            <th>Rest</th>
                            <th></th>
                        </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-2">
        <label asp-for="ReviewRating" class="form-label">Rating</label>
        <input asp-for="ReviewRating" class="form-control" min="1" max="5" />
    </div>
    <div class="col-md-10">
        <label asp-for="ReviewComment" class="form-label">Review</label>
        <input asp-for="ReviewComment" class="form-control" placeholder="How did the workout go?" />
    </div>

    <input asp-for="DraftPayloadJson" type="hidden" id="draftPayloadJson" />
    <input asp-for="StartedAtUtc" type="hidden" />

    <div class="col-12">
        <button type="submit" class="btn btn-success" id="finishWorkoutBtn">Finish workout</button>
    </div>
</form>
}

@if (Model.IsTrainingActive)
{
<script>
    const catalog = @Html.Raw(catalogJson);
    const draftSets = [];
    let timer = null;
    let timerLeft = 120;

    const groupFilter = document.getElementById("muscleGroupFilter");
    const subGroupFilter = document.getElementById("muscleSubGroupFilter");
    const exerciseSelect = document.getElementById("exerciseSelect");

    function getUniqueSubGroups(groupId) {
        const map = new Map();
        catalog
            .filter(x => x.MuscleGroupId === groupId)
            .forEach(x => {
                if (!map.has(x.MuscleSubGroupId)) {
                    map.set(x.MuscleSubGroupId, x.MuscleSubGroupName);
                }
            });

        return Array.from(map.entries()).map(([id, name]) => ({ id, name }));
    }

    function renderSubGroupOptions() {
        const groupId = parseInt(groupFilter.value || "0", 10);
        subGroupFilter.innerHTML = "";
        exerciseSelect.innerHTML = "";

        if (!groupId) {
            subGroupFilter.disabled = true;
            exerciseSelect.disabled = true;
            subGroupFilter.innerHTML = '<option value="">Select a group first</option>';
            exerciseSelect.innerHTML = '<option value="">Select a group first</option>';
            return;
        }

        const subGroups = getUniqueSubGroups(groupId);
        subGroupFilter.disabled = false;
        subGroupFilter.innerHTML = '<option value="">All subgroups</option>';
        subGroups.forEach(sg => {
            const option = document.createElement("option");
            option.value = sg.id;
            option.textContent = sg.name;
            subGroupFilter.appendChild(option);
        });
    }

    function renderExerciseOptions() {
        const groupId = parseInt(groupFilter.value || "0", 10);
        const subGroupId = parseInt(subGroupFilter.value || "0", 10);
        exerciseSelect.innerHTML = "";

        if (!groupId) {
            exerciseSelect.disabled = true;
            exerciseSelect.innerHTML = '<option value="">Select a group first</option>';
            return;
        }

        const filtered = catalog.filter(x =>
            x.MuscleGroupId === groupId &&
            (!subGroupId || x.MuscleSubGroupId === subGroupId));

        exerciseSelect.disabled = filtered.length === 0;

        if (filtered.length === 0) {
            exerciseSelect.innerHTML = '<option value="">No exercises for this group</option>';
            return;
        }

        filtered.forEach(x => {
            const option = document.createElement("option");
            option.value = x.ExerciseId;
            option.textContent = x.ExerciseName;
            exerciseSelect.appendChild(option);
        });
    }

    function renderDraftTable() {
        const tbody = document.querySelector("#draftSetsTable tbody");
        tbody.innerHTML = "";

        draftSets.forEach((item, index) => {
            const row = document.createElement("tr");
            row.innerHTML = `
                <td>${index + 1}</td>
                <td>${item.exerciseName}</td>
                <td>${item.setTypeName}</td>
                <td>${item.weightKg}</td>
                <td>${item.reps}</td>
                <td>${item.restSeconds} sec</td>
                <td><button type="button" class="btn btn-sm btn-outline-danger" data-index="${index}">Remove</button></td>`;
            tbody.appendChild(row);
        });

        document.getElementById("draftPayloadJson").value = JSON.stringify(draftSets);
    }

    function resetTimerText() {
        const minutes = Math.floor(timerLeft / 60).toString().padStart(2, "0");
        const seconds = (timerLeft % 60).toString().padStart(2, "0");
        document.getElementById("restTimerValue").textContent = `${minutes}:${seconds}`;
    }

    function stopTimer() {
        if (timer) {
            clearInterval(timer);
            timer = null;
        }
    }

    function startTimer() {
        stopTimer();
        timerLeft = parseInt(document.getElementById("restInput").value || "120", 10);
        if (timerLeft < 0) timerLeft = 120;
        document.getElementById("timerReadyText").textContent = "";
        resetTimerText();

        timer = setInterval(() => {
            timerLeft--;
            if (timerLeft <= 0) {
                stopTimer();
                timerLeft = 0;
                resetTimerText();
                document.getElementById("timerReadyText").textContent = "You can start the next set";
                return;
            }

            resetTimerText();
        }, 1000);
    }

    document.getElementById("addSetBtn").addEventListener("click", () => {
        const selectedExercise = exerciseSelect.options[exerciseSelect.selectedIndex];
        const setTypeSelect = document.getElementById("setTypeSelect");
        const selectedSetType = setTypeSelect.options[setTypeSelect.selectedIndex];

        if (!selectedExercise || !selectedSetType || !selectedExercise.value) {
            return;
        }

        draftSets.push({
            exerciseId: parseInt(selectedExercise.value, 10),
            exerciseName: selectedExercise.text,
            setTypeId: parseInt(selectedSetType.value, 10),
            setTypeName: selectedSetType.text,
            weightKg: parseFloat(document.getElementById("weightInput").value || "0"),
            reps: parseInt(document.getElementById("repsInput").value || "0", 10),
            restSeconds: parseInt(document.getElementById("restInput").value || "120", 10)
        });

        renderDraftTable();
        startTimer();
    });

    document.querySelector("#draftSetsTable tbody").addEventListener("click", (event) => {
        if (event.target.tagName !== "BUTTON") {
            return;
        }

        const index = parseInt(event.target.getAttribute("data-index"), 10);
        if (!isNaN(index)) {
            draftSets.splice(index, 1);
            renderDraftTable();
        }
    });

    document.getElementById("startTimerBtn").addEventListener("click", startTimer);
    document.getElementById("skipTimerBtn").addEventListener("click", () => {
        stopTimer();
        timerLeft = 0;
        resetTimerText();
        document.getElementById("timerReadyText").textContent = "You can start the next set";
    });

    groupFilter.addEventListener("change", () => {
        renderSubGroupOptions();
        renderExerciseOptions();
    });
    subGroupFilter.addEventListener("change", renderExerciseOptions);

    resetTimerText();
    renderSubGroupOptions();
    renderExerciseOptions();
    renderDraftTable();
</script>
}

