<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
        <!-- Keeps EF Core on the same patch as the design-time tools; the provider alone would select an older one. -->
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.15" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

</Project>
